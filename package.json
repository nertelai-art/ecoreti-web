    "resend": "6.31.0",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.7",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
